{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User account profiles, watchlists, favorites, and history",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "watchlist": { "type": "array", "items": { "type": "number" } },
        "favorites": { "type": "array", "items": { "type": "number" } },
        "watchHistory": { "type": "array", "items": { "type": "object" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    }
  }
}
