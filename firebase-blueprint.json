{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User account profiles, watchlists, favorites, and history",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "watchlist": { "type": "array", "items": { "type": "number" } },
        "favorites": { "type": "array", "items": { "type": "number" } },
        "watchHistory": { "type": "array", "items": { "type": "object" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "settings": {
      "title": "Site Settings",
      "description": "Global application configuration and announcement text",
      "type": "object",
      "properties": {
        "announcementText": { "type": "string" },
        "announcementActive": { "type": "boolean" },
        "featuredHeroIds": { "type": "array", "items": { "type": "number" } },
        "maintenanceMode": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/settings/{document}": {
      "schema": "settings",
      "description": "Global settings documents accessible publicly"
    }
  }
}
